# Application Settings
APP_NAME="APK Malware Detection System"
APP_VERSION="1.0.0"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Settings (Development)
DATABASE_URL=sqlite:///./data/apk_analyzer.db

# Database Settings (Production - ShaktiDB)
# DATABASE_URL=shaktidb://username:password@host:port/database

# ML Model Settings
MODEL_PATH=./data/models/malware_detector.pkl
FEATURE_EXTRACTOR_PATH=./data/models/feature_extractor.pkl
SCALER_PATH=./data/models/scaler.pkl

# Upload Settings
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
ALLOWED_EXTENSIONS=[".apk"]

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log

# Risk Scoring Thresholds (NIST CIA)
RISK_CRITICAL_THRESHOLD=80
RISK_HIGH_THRESHOLD=60
RISK_MEDIUM_THRESHOLD=40
RISK_LOW_THRESHOLD=20

# Security
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY_ENABLED=False

# VirusTotal API (Optional)
VT_API_KEY=your-virustotal-api-key-here
